{
  "name": "mobey",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript-eslint": "8.70.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "node -- scripts/compose-watch.mjs",
    "dev:down": "docker compose --env-file /dev/null down",
    "test:compose": "pnpm --filter @mobey/e2e exec playwright test local-compose.spec.ts --workers=1",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "format:check": "prettier --check .",
    "lint": "eslint eslint.config.mjs scripts --max-warnings=0 && turbo run lint",
    "test:ci-policy": "node --test scripts/ci-policy.test.mjs scripts/publication-preflight.test.mjs scripts/compose-watch.test.mjs",
    "test:compose-watch": "node --test scripts/compose-watch.test.mjs",
    "test:publication": "node --test scripts/publication-preflight.test.mjs",
    "publication:preflight": "node scripts/publication-preflight.mjs preflight",
    "publication:verify": "node scripts/publication-preflight.mjs verify",
    "test:platform": "pnpm --filter @mobey/e2e exec playwright test platform-smoke.spec.ts --workers=1",
    "test:coverage": "pnpm --filter @mobey/shared --filter @mobey/web --filter @mobey/api run test:coverage",
    "test": "turbo run test",
    "contract": "turbo run contract",
    "infrastructure": "turbo run infrastructure",
    "migrate": "turbo run migrate",
    "deploy": "turbo run deploy"
  }
}
