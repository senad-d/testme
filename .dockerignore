# Allowlist build inputs: never send the checkout's credentials or agent state.
# Compose treats * specially, avoiding basename-based initial-sync filtering.
# Retain ** for recursive build-context denial; explicit Watch exclusions in
# compose.yaml must stay aligned with the sensitive/artifact rules below.
*
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!patches/
patches/*
!patches/*.patch
# Re-deny children of traversal directories before allowing exact inputs.
!apps/
apps/*
!apps/api/
apps/api/*
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/**
!apps/web/
apps/web/*
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src/
!apps/web/src/**
!packages/
packages/*
!packages/shared/
packages/shared/*
!packages/shared/package.json
!packages/shared/tsconfig.json
!packages/shared/src/
!packages/shared/src/**
!packages/content/
packages/content/*
!packages/content/package.json
!packages/content/tsconfig.json
!packages/content/src/
!packages/content/src/**
!tests/
tests/*
!tests/e2e/
tests/e2e/*
!tests/e2e/package.json
# Even inside allowed source trees, exclude local and test-only artifacts.
**/.env
**/.env.*
**/.pi
**/.git
**/node_modules
**/.DS_Store
**/*.test.*
**/*.spec.*
**/.aws
**/.azure
**/.oci
**/.ssh
**/.config
**/.npmrc
**/.netrc
**/.pgpass
**/.git-credentials
**/credentials
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.tsbuildinfo
**/dist
**/coverage
**/test-results
