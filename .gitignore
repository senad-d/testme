# Operating system artifacts
.DS_Store

# Node.js and pnpm dependencies, stores, and logs
node_modules/
.pnpm-store/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Turborepo cache
.turbo/

# TypeScript, build, test, coverage, and Playwright outputs
*.tsbuildinfo
dist/
build/
out/
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Local environment files; reviewed templates stay versioned
.env
.env.*
!.env.example
!.env.*.example

# Local pi and IssueMe state/cache
/.pi/

# Terraform local cache, state, plans, crashes, and overrides
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep lockfiles, migrations, generated API contracts, source, config, and docs trackable
!/pnpm-lock.yaml
!**/.terraform.lock.hcl
!**/migrations/**/*.sql
!/packages/shared/src/generated/**
