{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vitest/globals"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["src/**/*.ts"]
}
